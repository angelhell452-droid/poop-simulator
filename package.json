{
  "name": "poop-simulator",
  "version": "4.9.58",
  "description": "Poop Simulator - Cloudflare Pages and Cloudflare D1 Database",
  "main": "index.html",
  "scripts": {
    "build": "echo 'Build complete'",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create poop_simulator_d1",
    "d1:init:local": "wrangler d1 execute poop_simulator_d1 --local --file=./schema.sql",
    "d1:init:remote": "wrangler d1 execute poop_simulator_d1 --remote --file=./schema.sql",
    "db:generate": "drizzle-kit generate",
    "test": "echo \"Ready for Cloudflare Pages\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "drizzle-orm": "^0.38.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "drizzle-kit": "^0.30.4",
    "wrangler": "^3.109.2"
  }
}